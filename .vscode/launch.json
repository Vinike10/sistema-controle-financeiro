{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Abrir Control DIN no Chrome (Direto sem servidor)",
            "type": "chrome",
            "request": "launch",
            "file": "${workspaceFolder}/index.html"
        },
        {
            "name": "Abrir no Chrome (Servidor Local 8080)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Abrir no Chrome (Live Server 5500)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5500/index.html",
            "webRoot": "${workspaceFolder}"
        }
    ]
}