# ==============================================================================
# 🛡️ .gitignore - Proteção e Segurança de Informações (Control DIN)
# ==============================================================================

# Arquivos de Ambiente e Credenciais Locais
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
secrets.json
config.local.js

# Arquivos de Backup Local e Exportações com Dados Pessoais
*.bak
*.backup
*.dump
backup-*.json
export-*.json
dados-*.json
relatorio-*.csv
relatorio-*.xlsx

# Logs e Arquivos Temporários
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp

# Arquivos do Sistema Operacional (Windows / macOS / Linux)
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Configurações Pessoais de Editores e IDEs
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/


# Diretrizes e Instruções para Agentes de IA / Assistentes
AGENTS.md
[Aa]gents.md
GEMINI.md
CLAUDE.md
CHATGPT.md
*.agent.md
*agent-instructions*
.agents/
.agent/
.cursorrules
.cursor/
.windsurf/
.windsurfrules
copilot-instructions.md
.github/copilot-instructions.md
.gemini/
.system_generated/
scratch/
